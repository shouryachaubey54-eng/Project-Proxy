<%if(success && success.length){%>
    <div class="container alert alert-success alert-dismissible fade show col-4" role="alert">
        <%=success%>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<%}%>
<%if(err && err.length){%>
    <div class="container alert alert-danger alert-dismissible fade show col-4" role="alert">
        <%=err%>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<%}%>
