<% layout('./layouts/boilerplate') -%>
<body>
  <div class="container py-5 ">
    <div class="row justify-content-center">
      <div class="col-md-9 col-lg-8">
        <div class="main-card mb-5 overflow-hidden">
          <div class="img-container position-relative">
            <img src="<%= info.image %>" class="card-img-top object-fit-cover" alt="<%= info.title %>">
            <span class="badge img-badge text-dark ">
               <%= info.location %>, <%= info.country %>
            </span>
          </div>
          <div class="card-body p-4 p-md-5">
            <p class="card-text text-secondary lead fs-6 mb-3">Owned By <b><%= info.owner.username %></b></p>

            <div class="d-flex justify-content-between align-items-center mb-3">
              <h1 class="card-title fw-bold text-dark mb-0"><%= info.title %></h1>
              <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">Available for Rent</span>
            </div>
            
            <p class="card-text text-secondary lead fs-6 my-4"><%= info.description %></p>

            <!-- Price and Booking Section -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pt-4 border-top mb-2">
              <div>
                <small class="text-muted d-block text-uppercase fw-semibold">Rental Rate</small>
                <span class="fs-2 fw-bold text-dark">&#8377;<%= info.price.toLocaleString('en-IN') %></span>
                <span class="text-muted">/ day</span>
              </div>

              <!-- Booking and Action Buttons Aligned -->
              <div class="d-flex align-items-center gap-2">
                <%if(currentUser && !currentUser._id.equals(info.owner._id)){%>
                  <a href="/listings/booking/<%=info._id%>" class="btn btn-primary px-4 py-2 rounded-3 fw-semibold shadow-sm">Book Now</a>
                <%}else if(!currentUser){%>
                  <p>Login to Book Rides!!</p>
                <%}%>
                
                
                <% if(currentUser && currentUser._id.equals(info.owner._id)){ %>
                  <a href="/listings/<%= info._id %>/edit" class="btn btn-outline-secondary px-3 py-2 rounded-3 fw-semibold">Edit</a>
                  <a href="/listings/<%= info._id %>/delete" class="btn btn-outline-danger px-3 py-2 rounded-3 fw-semibold">Delete</a>
                <% } %>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>

    <!-- Review Submission Form -->
    <div class="row justify-content-center ">
      <% if(currentUser){ %>
        <div class="col-md-9 col-lg-8">
          <div class="form-card p-4 p-md-5 mb-5 border rounded-4 bg-white shadow-sm">
            <h4 class="fw-bold mb-4 text-dark">Leave a Review</h4>
            
            <form method="POST" action="/listings/<%= info._id %>/review" novalidate class="needs-validation">
              
              <!-- Star Rating Input -->
              <div class="mb-4">
                <label class="form-label fw-semibold text-secondary d-block">Your Rating</label>
                <div class="star-rating d-inline-flex flex-row-reverse gap-1 fs-4">
                  <input type="radio" id="star5" name="review[rating]" value="5" class="d-none" required />
                  <label for="star5" title="5 stars" class="cursor-pointer">★</label>
                  
                  <input type="radio" id="star4" name="review[rating]" value="4" class="d-none" />
                  <label for="star4" title="4 stars" class="cursor-pointer">★</label>
                  
                  <input type="radio" id="star3" name="review[rating]" value="3" class="d-none" checked />
                  <label for="star3" title="3 stars" class="cursor-pointer">★</label>
                  
                  <input type="radio" id="star2" name="review[rating]" value="2" class="d-none" />
                  <label for="star2" title="2 stars" class="cursor-pointer">★</label>
                  
                  <input type="radio" id="star1" name="review[rating]" value="1" class="d-none" />
                  <label for="star1" title="1 star" class="cursor-pointer">★</label>
                </div>
              </div>

              <div class="mb-4">
                <label for="Text" class="form-label fw-semibold text-secondary">Your Experience</label>
                <textarea name="review[comment]" id="Text" class="form-control rounded-3 p-3 bg-light border-0" rows="3" placeholder="Share details of your ride..." required></textarea>
                <div class="invalid-feedback">Please enter a comment before submitting.</div>
              </div>

              <button class="btn btn-primary px-4 py-2 rounded-3 fw-semibold shadow-sm">Submit Review</button>
            </form>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Reviews Section -->
    <div class="row justify-content-center ">
      <div class="col-md-9 col-lg-8">
        <h4 class="fw-bold mb-4 text-dark">All Reviews</h4>

        <% if (info.review && info.review.length > 0) { %>
          <div class="row g-3">
            <% for(reviews of info.review) { %>
              <div class="col-md-6">
                <div class="review-card h-100 p-4 border">
                  <div>
                        <p>CreatedBy <%=currentUser.username%></p>
                      </div>
                  <div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                      <!-- Dynamic Star Output -->
                       
                      <div class="fs-5 text-warning">
                        <% for(let i = 1; i <= 5; i++) { %>
                          <% if (i <= reviews.rating) { %>
                            ★
                          <% } else { %>
                            <span class="text-secondary opacity-25">★</span>
                          <% } %>
                        <% } %>
                      </div>
                      <% if(currentUser && currentUser._id.equals(reviews.owner)){ %>
                        <form method="POST" action="/listings/<%= info._id %>/review/<%= reviews._id %>?_method=DELETE">
                          <button class="btn btn-link text-danger p-0 border-0 text-decoration-none small opacity-75">Delete</button>
                        </form>
                      <% } %>
                    </div>
                    <p class="card-text text-secondary mb-0">
                      "<%= reviews.comment %>"
                    </p>
                  </div>
                </div>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <div class="text-center py-4 bg-white rounded-4 shadow-sm ">
            <p class="text-muted mb-0">
              <% if(!currentUser) { %>
                Login to Add Reviews!
              <% } else { %>
                No reviews yet. Be the first to share your experience!
              <% } %>
            </p>
          </div>
        <% } %>

      </div>
    </div>

  </div>
</body>