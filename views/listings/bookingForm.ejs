
 <% layout('./layouts/boilerplate') -%>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"> -->
</head>
<body>

  <div class="booking-card">
    <h2>Complete Your Booking</h2>

   
    <script id="disabled-ranges-data" type="application/json">
      <%- JSON.stringify(disabledRanges) %>
    </script>

    <form action="/listings/booking/<%= id %>" method="POST">
      <div class="form-group">
        <label for="bookingTime">Start Date & Time</label>
        <input type="text" id="bookingTime" name="listings[bookingTime]" required placeholder="Select Start Date" readonly>
      </div>

      <div class="form-group">
        <label for="returnTime">End Date & Time</label>
        <input type="text" id="returnTime" name="listings[returnTime]" required placeholder="Select End Date" readonly>
      </div>

      <button type="submit" class="btn-submit">Confirm Booking</button>
    </form>
  </div>


  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

  <script>
  
    const rawData = document.getElementById('disabled-ranges-data').textContent;
    const disabledRanges = JSON.parse(rawData);

  
    const disableList = disabledRanges.map(range => ({
      from: new Date(range.from),
      to: new Date(range.to)
    }));

    
    const startPicker = flatpickr("#bookingTime", {
      enableTime: true,
      dateFormat: "Y-m-d H:i",
      minDate: "today",
      disable: disableList,
      onChange: function(selectedDates) {
        if (selectedDates[0]) {
          endPicker.set("minDate", selectedDates[0]);
        }
      }
    });

    const endPicker = flatpickr("#returnTime", {
      enableTime: true,
      dateFormat: "Y-m-d H:i",
      minDate: "today",
      disable: disableList
    });
  </script>

</body>
</html>