<% layout('./layouts/boilerplate') -%>
<body>
    <div class="row row-cols-lg-3 row-cols-md-2 mt-3">
        <%for(list of listings){%>
         <a href="/listings/<%=list._id%>" class="listing-link"> 
        <div class="card col" >
            <img src="<%=list.image%>" class="card-img-top" alt="...">
            <div class="card-img-overlay d-flex flex-column justify-content-start p-2">
            <span class="badge bg-primary-subtle text-primary rounded-pill w-auto align-self-start mb-2 px-3">Available</span>
            </div>
            <div class="card-body">
            <p class="card-text"><b><%=list.title%></b>
            <br>
            &#8377;<%=list.price.toLocaleString('en-IN')%>/Night
            </p>
            </div>
        </div>
        </a>  
        <%}%>   
    </div>
  
    
</body>